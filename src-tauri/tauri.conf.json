{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tat2",
  "version": "1.0.0",
  "identifier": "com.moonspark.tat2",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Tat2",
        "width": 420,
        "height": 560,
        "minWidth": 320,
        "minHeight": 360,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/moonspark316/tat2/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4QTk2QkY1MjdFOURDOUYKUldTZjNPa245V3VwS1A2TUo3OENWaXYxUlQyR2YzOEI5TVZiMG5LMy8rSnBqdFc2Ky9MM3lYVzEK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
